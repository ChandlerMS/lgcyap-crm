{
  "name": "lgcyap-hiring-event-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Local tooling for the hiring-event sites: QR generation, the printable PDF, QR checks and previews. Not deployed.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "qr": "node scripts/generate-qr.mjs",
    "pdf": "node scripts/make-pdf.mjs",
    "verify-qr": "node scripts/verify-qr.mjs",
    "test": "node --test \"signin/tests/*.test.mjs\"",
    "dev:signin": "node scripts/dev-server.mjs signin 3010 --dry-run",
    "dev:qr": "node scripts/dev-server.mjs signinqr 3011"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "qrcode": "1.5.4"
  }
}
