# Copy to .env.local for local setup. Enter real values directly in the
# provider/Vercel secret settings. Never commit .env.local or production secrets.
# This exact origin must also be registered with Google's OAuth client.
BETTER_AUTH_URL=http://localhost:4190
# Generate a fresh random secret of at least 32 characters for each environment.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail drafts reuse this OAuth client and /api/auth/callback/google, with their
# own consent/state and encrypted refresh token. Enable Gmail API in the Google
# Cloud project. Each employee must connect their matching account in Email.
# Gmail draft creation is available only on Vercel Production; the app requests
# gmail.compose (Google also permits sending under this scope) but only creates
# drafts. Users review/send in Gmail. No inbox-read permission is requested.
# Optional compressed server-only offer templates used by Email. Existing value
# can be retained when switching from HubSpot email to Gmail drafts.
RECRUIT_OFFER_TEMPLATES=
# Optional exact Workspace domain; required when external exceptions are used.
# Blank still requires a Workspace account, except for exact exceptions. The main email allowlist
# is always enforced as well.
GOOGLE_WORKSPACE_DOMAIN=
# Optional comma-separated exact @gmail.com addresses, each also required in
# RECRUITING_EDITOR_EMAILS. Empty preserves Workspace-only sign-in. Removing an
# exception denies its next recruiting request even if its session still exists.
GOOGLE_PERSONAL_EMAILS=
# Optional exact non-Gmail addresses outside the configured company domain,
# each also required in RECRUITING_EDITOR_EMAILS. Requires an exact Workspace
# domain above. Removing an exception denies its next request, including existing
# sessions, while the company domain remains configured. No domain-wide grants.
GOOGLE_EXTERNAL_EMAILS=
# Use a separate Postgres database for this migration. For Neon, use its pooled
# connection string with TLS enabled. Do not use the existing Sites D1 database.
DATABASE_URL=
# Comma-separated exact Google account email addresses; empty denies everyone.
RECRUITING_EDITOR_EMAILS=
# Server-only HubSpot private-app credential. Leave empty for offline tests.
HUBSPOT_ACCESS_TOKEN=
# Optional server-only HubSpot service key with only the files permission, used just to
# show applicants' photo IDs on the Applications page. Empty uses HUBSPOT_ACCESS_TOKEN.
HUBSPOT_FILES_ACCESS_TOKEN=
# Queue: server-only PolicyTek HUD session, never NEXT_PUBLIC_ variables.
POLICYTEK_REFRESH_TOKEN=
POLICYTEK_WORKSPACE_ID=
# Remains false until the new environment and a deliberate save are verified.
# Vercel Preview deployments block writes even if this is accidentally true.
RECRUITING_WRITES_ENABLED=false
# Contact creation additionally requires verified contacts-read/write access in
# the Production app and migration 0002. Preview/local still cannot create.
RECRUITING_CONTACT_CREATION_ENABLED=false

# Optional stable key (32+ characters) for signed Event Attendance review notes.
# Defaults to BETTER_AUTH_SECRET. Keep previous keys when rotating either key so
# existing approved/denied decisions remain readable; comma-separated, server only.
# EVENT_REVIEW_HMAC_SECRET=
# EVENT_REVIEW_PREVIOUS_SECRETS=

# Server-only base64 AES-256-GCM key for the encrypted call-history snapshot.
# Set only in Production; never use a NEXT_PUBLIC_ variable or commit a real key.
SVP_DISPOSITIONS_KEY=

# Optional separate 32+ character server-to-server secret for immediate application
# sync notifications. Minutely production checks and 9 am Eastern repair do not
# require this hook. Never put it in a browser or a public application form.
APPLICATION_SHEETS_NOTIFY_SECRET=

# Custom HubSpot Recruits mirror (Production only; approved schema setup, auto intake and two-way synchronization).
RECRUITING_CUSTOM_SYNC_ENABLED=false

# Legacy private Conversations guard only; the Email page now uses Gmail.
# Retain this value if configured so the separate HubSpot Inbox continues to
# protect private conversations. It is not needed for connecting Gmail drafts.
HUBSPOT_CHANDLER_INBOX_ID=

# Optional 32+ character server-to-server sign-in notification secret.
# Minutely sign-in checks and 9 am Eastern repair work without this optional hook.
SIGN_IN_SHEETS_NOTIFY_SECRET=
