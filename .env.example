# Copy to .env.local for local setup. Enter real values directly in the
# provider/Vercel secret settings. Never commit .env.local or production secrets.
# This exact origin must also be registered with Google's OAuth client.
BETTER_AUTH_URL=http://localhost:4190
# Generate a fresh random secret of at least 32 characters for each environment.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional exact Workspace domain. Blank still requires a Google Workspace
# account; the explicit email allowlist below is always enforced as well.
GOOGLE_WORKSPACE_DOMAIN=
# Use a separate Postgres database for this migration. For Neon, use its pooled
# connection string with TLS enabled. Do not use the existing Sites D1 database.
DATABASE_URL=
# Comma-separated exact Google account email addresses; empty denies everyone.
RECRUITING_EDITOR_EMAILS=
# Server-only HubSpot private-app credential. Leave empty for offline tests.
HUBSPOT_ACCESS_TOKEN=
# Remains false until the new environment and a deliberate save are verified.
# Vercel Preview deployments block writes even if this is accidentally true.
RECRUITING_WRITES_ENABLED=false
