{
  "name": "legacy-recruiting-vercel",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit --incremental false",
    "lint": "eslint app lib db tests scripts next.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "preflight": "node --env-file-if-exists=.env.local scripts/preflight.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "db:auth:check": "node --env-file-if-exists=.env.local scripts/auth-migration.mjs --check",
    "db:auth:migrate": "node --env-file-if-exists=.env.local scripts/auth-migration.mjs --apply"
  },
  "dependencies": {
    "@next/env": "16.4.3",
    "@vercel/functions": "3.6.1",
    "better-auth": "1.7.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.0"
  }
}
