# Copy to .env.local for `npm run dev`. On Vercel, set these in Project -> Settings -> Environment Variables.
# Everything is optional locally: with no DATABASE_URL the dev server uses an embedded Postgres in .data/,
# and with no Google values email and calendars show as "not set up".

# Postgres. Vercel sets this when you connect a database (Storage -> Neon). Not needed locally.
DATABASE_URL=

# Google OAuth web client (Google Cloud console -> APIs & Services -> Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# From `npm run google:team`, signed in as MAIL_FROM: sends email and reads TEAM_CALENDARS.
GOOGLE_TEAM_REFRESH_TOKEN=
# From `npm run google:inbox`, signed in as INDEED_INBOX: reads Indeed notices.
GOOGLE_INBOX_REFRESH_TOKEN=

# A long random string. Vercel sends it with the daily cron job; /api/cron refuses requests without it.
CRON_SECRET=

# Optional; these are the defaults.
# MAIL_FROM=carlos@lgcyap.com
# MAIL_FROM_NAME=Legacy Agency Partners
# TEAM_CALENDARS=carlos@lgcyap.com,ed@lgcyap.com
# INDEED_INBOX=recruitinglegacyam@gmail.com
# OWNER_EMAILS=

# Local only: print sign-in codes in the terminal instead of emailing them. Ignored on Vercel.
DEV_LOGIN_CODES=1
